<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.spring.infrastructure.mybatis.readservice.TestUserReadService">
    <select id="findByUsername" resultType="io.spring.application.data.UserData">
        select id, username, email, bio, image from users where username = #{username}
    </select>

    <select id="findById" resultType="io.spring.application.data.UserData">
        select id, username, email, bio, image from users where id = #{id}
    </select>
</mapper>
